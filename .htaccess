# Deyscom Motorsport · configuración para servidores Apache
Options -Indexes -MultiViews
ErrorDocument 404 /404.html

# Forzar HTTPS y dominio sin www
RewriteEngine On
RewriteBase /
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://deyscom.com%{REQUEST_URI} [L,R=301]

# Proteger carpetas internas y archivos de configuración del hosting
RewriteRule ^(tools|google-apps-script|content|\.github)/ - [F,L]
RewriteRule ^(_headers|_redirects|netlify\.toml|requirements\.txt)$ - [F,L]

# Redirecciones 301 de la web antigua → nueva (una línea por URL antigua; ver README → IONOS)
# RewriteRule ^antigua-url/?$ https://deyscom.com/competicion/ [R=301,L,NC]
RewriteRule ^experiencia-rally-eurocem(\.html|/)?$ https://deyscom.com/experiencias/ [R=301,L]
RewriteRule ^camiseta-edicion-especial-el-molar-2026(\.html|/)?$ https://deyscom.com/tienda/ [R=301,L]

# Direcciones típicas de la web antigua → páginas nuevas
RewriteRule ^index\.php$ https://deyscom.com/ [R=301,L]
RewriteRule ^(quienes-somos|sobre-nosotros|about|empresa|historia)/?$ https://deyscom.com/nosotros/ [R=301,L,NC]
RewriteRule ^(contactar|contact|presupuesto|donde-estamos)/?$ https://deyscom.com/contacto/ [R=301,L,NC]
RewriteRule ^(taller|preparacion|preparaciones|taller-competicion|coches-de-competicion|rally|mecanica)/?$ https://deyscom.com/competicion/ [R=301,L,NC]
RewriteRule ^(chapa-y-pintura|chapa|carroceria)/?$ https://deyscom.com/pintura/ [R=301,L,NC]
RewriteRule ^(restauracion|restauraciones|clasicos)/?$ https://deyscom.com/restomod/ [R=301,L,NC]
RewriteRule ^(banco|dinamometro|potencia)/?$ https://deyscom.com/banco-de-potencia/ [R=301,L,NC]
RewriteRule ^(cursos|curso|experiencia|rally-experience|alquiler|alquiler-coches)/?$ https://deyscom.com/experiencias/ [R=301,L,NC]
RewriteRule ^(shop|productos|merchandising|coches-en-venta|venta)/?$ https://deyscom.com/tienda/ [R=301,L,NC]
RewriteRule ^(noticias|news|actualidad)/?$ https://deyscom.com/blog/ [R=301,L,NC]

# Direcciones limpias, sin .html: /restomod.html → /restomod/ y /restomod → /restomod/
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^index\.html$ https://deyscom.com/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([a-z0-9-]+)\.html[\s?]
RewriteRule ^([a-z0-9-]+)\.html$ https://deyscom.com/$1/ [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} ^(.*?)/?$
RewriteCond %1.html -f
RewriteRule ^([a-z0-9-]+)$ https://deyscom.com/$1/ [R=301,L]
# /restomod/ muestra restomod.html (sin cambiar la dirección)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} ^(.*?)/?$
RewriteCond %1.html -f
RewriteRule ^([a-z0-9-]+)/$ /$1.html [L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Área privada (CRM): fuera de buscadores y sin caché
<Files "crm.html">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
    Header set Cache-Control "no-store"
  </IfModule>
</Files>
