# Deyscom Motorsport · configuración para servidores Apache
Options -Indexes
ErrorDocument 404 /404.html

# Forzar HTTPS y dominio sin www
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://deyscom.com%{REQUEST_URI} [L,R=301]

# Proteger carpetas internas y archivos de configuración del hosting
RewriteRule ^(tools|google-apps-script|content|\.github)/ - [F,L]
RewriteRule ^(_headers|_redirects|netlify\.toml|requirements\.txt)$ - [F,L]

# Redirecciones 301 de la web antigua → nueva (una línea por URL antigua; ver README → IONOS)
# Redirect 301 /antigua-url/ https://deyscom.com/competicion.html
Redirect 301 /experiencia-rally-eurocem.html https://deyscom.com/experiencias.html

# Direcciones típicas de la web antigua → páginas nuevas (sin .html, con barra final o con otro nombre)
RewriteRule ^index\.php$ https://deyscom.com/ [R=301,L]
RewriteRule ^(quienes-somos|sobre-nosotros|about|empresa|historia)/?$ https://deyscom.com/nosotros.html [R=301,L,NC]
RewriteRule ^(contactar|contact|presupuesto|donde-estamos)/?$ https://deyscom.com/contacto.html [R=301,L,NC]
RewriteRule ^(taller|preparacion|preparaciones|taller-competicion|coches-de-competicion|rally|mecanica)/?$ https://deyscom.com/competicion.html [R=301,L,NC]
RewriteRule ^(chapa-y-pintura|chapa|carroceria)/?$ https://deyscom.com/pintura.html [R=301,L,NC]
RewriteRule ^(restauracion|restauraciones|clasicos)/?$ https://deyscom.com/restomod.html [R=301,L,NC]
RewriteRule ^(banco|dinamometro|potencia)/?$ https://deyscom.com/banco-de-potencia.html [R=301,L,NC]
RewriteRule ^(cursos|curso|experiencia|rally-experience|alquiler|alquiler-coches)/?$ https://deyscom.com/experiencias.html [R=301,L,NC]
RewriteRule ^(shop|productos|merchandising|coches-en-venta|venta)/?$ https://deyscom.com/tienda.html [R=301,L,NC]
RewriteRule ^(noticias|news|actualidad)/?$ https://deyscom.com/blog.html [R=301,L,NC]
# /pagina o /pagina/ → /pagina.html cuando esa página existe
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([a-z0-9-]+)/?$ https://deyscom.com/$1.html [R=301,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Área privada (CRM): fuera de buscadores y sin caché
<Files "crm.html">
  <IfModule mod_headers.c>
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
    Header set Cache-Control "no-store"
  </IfModule>
</Files>
